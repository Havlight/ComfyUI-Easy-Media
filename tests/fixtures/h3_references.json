{
  "cases": [
    {
      "name": "muted and locked audio give no reference; images skip muted entries",
      "task": {"id": "t1", "start_frame": 0, "end_frame": 120, "content": {"images": [
        {"id": "img1", "source_type": "input", "file_path": "a.png", "shared_reference": true},
        {"id": "img2", "source_type": "input", "file_path": "b.png", "muted": true},
        {"id": "prev", "source_type": "previous_frame"}
      ]}},
      "next_start": 120,
      "tracks": [
        {"id": "v1", "type": "video", "segments": [
          {"id": "v1a", "start_frame": 0, "end_frame": 200, "content": {"media_type": "video", "file_path": "v.mp4"}}]},
        {"id": "a1", "type": "audio", "segments": [
          {"id": "a1a", "start_frame": 0, "end_frame": 50, "content": {"media_type": "audio", "file_path": "a.wav"}}]},
        {"id": "a2", "type": "audio", "muted": true, "segments": [
          {"id": "a2a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "audio", "file_path": "m.wav"}}]},
        {"id": "a3", "type": "audio", "audio_locked": true, "segments": [
          {"id": "a3a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "audio", "file_path": "song.wav"}}]},
        {"id": "s1", "type": "subtitle", "segments": [
          {"id": "s1a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "subtitle", "text": "hi"}}]}
      ],
      "expected": {
        "images": ["img1", "prev"],
        "videos": [{"key": "track:v1", "kind": "track", "start_frame": 0, "frames": 120, "soundtrack": true}],
        "audios": [{"key": "track:a1", "kind": "track", "start_frame": 0, "frames": 50, "soundtrack": false}],
        "labels": {"images": ["Picture 1", "Picture 2"], "videos": ["Video 1"],
                   "video_soundtracks": ["Audio 1"], "audios": ["Audio 2"]}
      }
    },
    {
      "name": "shared clips come first, once per source, and a muted video has no soundtrack",
      "task": {"id": "t1", "start_frame": 0, "end_frame": 100, "content": {}},
      "next_start": null,
      "tracks": [
        {"id": "v1", "type": "video", "segments": [
          {"id": "v1w", "start_frame": 0, "end_frame": 60, "content": {"media_type": "video", "file_path": "w.mp4"}},
          {"id": "v1s", "start_frame": 300, "end_frame": 400, "content": {"media_type": "video", "source_type": "input", "file_path": "s.mp4", "shared_reference": true}}]},
        {"id": "v2", "type": "video", "segments": [
          {"id": "v2s", "start_frame": 0, "end_frame": 100, "content": {"media_type": "video", "source_type": "input", "file_path": "s.mp4", "shared_reference": true}}]},
        {"id": "v3", "type": "video", "muted": true, "segments": [
          {"id": "v3w", "start_frame": 10, "end_frame": 90, "content": {"media_type": "video", "file_path": "x.mp4"}}]},
        {"id": "a1", "type": "audio", "segments": [
          {"id": "a1s", "start_frame": 500, "end_frame": 600, "content": {"media_type": "audio", "source_type": "input", "file_path": "voice.wav", "shared_reference": true}},
          {"id": "a1w", "start_frame": 0, "end_frame": 100, "content": {"media_type": "audio", "file_path": "bed.wav"}}]}
      ],
      "expected": {
        "images": [],
        "videos": [
          {"key": "shared:v1s", "kind": "shared", "start_frame": 0, "frames": 100, "soundtrack": true},
          {"key": "track:v1", "kind": "track", "start_frame": 0, "frames": 60, "soundtrack": true},
          {"key": "track:v3", "kind": "track", "start_frame": 0, "frames": 90, "soundtrack": false}],
        "audios": [
          {"key": "shared:a1s", "kind": "shared", "start_frame": 0, "frames": 100, "soundtrack": false},
          {"key": "track:a1", "kind": "track", "start_frame": 0, "frames": 100, "soundtrack": false}],
        "labels": {"images": [], "videos": ["Video 1", "Video 2", "Video 3"],
                   "video_soundtracks": ["Audio 1", "Audio 2", null], "audios": ["Audio 3", "Audio 4"]}
      }
    },
    {
      "name": "the last task window ends with the task; media after it is ignored",
