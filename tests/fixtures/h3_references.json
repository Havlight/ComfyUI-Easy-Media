        "videos": [],
        "audios": [{"key": "track:a1", "kind": "track", "start_frame": 0, "frames": 140, "soundtrack": false}],
        "labels": {"images": [], "videos": [], "video_soundtracks": [], "audios": ["Audio 1"]}
      }
    },
    {
      "name": "a locked video replaces every other reference video",
      "task": {"id": "t1", "start_frame": 0, "end_frame": 100, "content": {}},
      "next_start": null,
      "tracks": [
        {"id": "v1", "type": "video", "segments": [
