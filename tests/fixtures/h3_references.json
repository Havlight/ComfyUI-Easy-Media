{
  "cases": [
    {
      "name": "muted and locked audio give no reference; images skip muted entries",
      "task": {"id": "t1", "start_frame": 0, "end_frame": 120, "content": {"images": [
        {"id": "img1", "source_type": "input", "file_path": "a.png", "shared_reference": true},
        {"id": "img2", "source_type": "input", "file_path": "b.png", "muted": true},
        {"id": "prev", "source_type": "previous_frame"}
      ]}},
      "next_start": 120,
      "tracks": [
        {"id": "v1", "type": "video", "segments": [
          {"id": "v1a", "start_frame": 0, "end_frame": 200, "content": {"media_type": "video", "file_path": "v.mp4"}}]},
        {"id": "a1", "type": "audio", "segments": [
          {"id": "a1a", "start_frame": 0, "end_frame": 50, "content": {"media_type": "audio", "file_path": "a.wav"}}]},
        {"id": "a2", "type": "audio", "muted": true, "segments": [
          {"id": "a2a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "audio", "file_path": "m.wav"}}]},
        {"id": "a3", "type": "audio", "audio_locked": true, "segments": [
          {"id": "a3a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "audio", "file_path": "song.wav"}}]},
        {"id": "s1", "type": "subtitle", "segments": [
          {"id": "s1a", "start_frame": 0, "end_frame": 120, "content": {"media_type": "subtitle", "text": "hi"}}]}
      ],
      "expected": {
        "images": ["img1", "prev"],
        "videos": [{"key": "track:v1", "kind": "track", "start_frame": 0, "frames": 120, "soundtrack": true}],
        "audios": [{"key": "track:a1", "kind": "track", "start_frame": 0, "frames": 50, "soundtrack": false}],
        "labels": {"images": ["Picture 1", "Picture 2"], "videos": ["Video 1"],
                   "video_soundtracks": ["Audio 1"], "audios": ["Audio 2"]}
      }
    },
    {
